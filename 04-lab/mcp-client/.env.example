# yescale-gemini / yescale / openai-compatible / gemini
# Browser experiment: Gemini via YesScale's OpenAI-compatible API.
LLM_PROVIDER=yescale
LLM_MODEL=gemini-2.5-flash
YESCALE_BASE_URL=https://api.yescale.io/v1
YESCALE_API_KEY=
# A Google key is needed only for direct Google (LLM_PROVIDER=gemini).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://api.yescale.io
# For native Google SDK via YesScale, set LLM_PROVIDER=yescale-gemini.
# ADK event streaming stays enabled; provider token streaming is optional.
GEMINI_STREAMING=0
MCP_SERVER_URL=http://127.0.0.1:8085/mcp
